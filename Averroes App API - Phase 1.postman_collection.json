  "item": [
    {
      "name": "Weekly Class Routine",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/student/routine",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "student",
            "routine"
          ]
        },
        "description": "Returns the authenticated student's weekly timetable, periods, subjects, teachers, rooms, and notes."
      },
      "response": []
    },
    {
      "name": "Today's Live Classes",
