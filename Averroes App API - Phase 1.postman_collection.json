    {
      "name": "Student Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "try {\r",
              "    const res = pm.response.json();\r",
              "    if (res.status === \"success\" && res.data && res.data.access_token) {\r",
              "        pm.collectionVariables.set(\"student_access_token\", res.data.access_token);\r",
              "        console.log(\"Token saved successfully!\");\r",
              "    }\r",
              "} catch (e) {\r",
              "    console.log(\"Response was not JSON or Server Crashed (500)\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "packages": {},
            "type": "text/javascript"
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {
          "accept": true
        }
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "https://averroesint.com/averroes_school_erp/api/login",
          "protocol": "https",
          "host": [
            "averroesint",
            "com"
          ],
          "path": [
            "averroes_school_erp",
            "api",
            "login"
          ]
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{student_access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
          "pm.test('Response has standard envelope', function () {",
          "  const body = pm.response.json();",
          "  pm.expect(body).to.have.property('status');",
          "  pm.expect(body).to.have.property('message');",
          "  pm.expect(body).to.have.property('request_id');",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://averroesint.com/averroes_school_erp/api"
    },
    {
      "key": "student_access_token",
      "value": ""
    },
    {
      "key": "live_class_id",
      "value": "1"
    }
  ]
}