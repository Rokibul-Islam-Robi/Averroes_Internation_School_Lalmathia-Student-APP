{
  "info": {
    "_postman_id": "92d2f331-7c51-45a3-b551-a2f8c2b2b22f",
    "name": "Averroes App API - Phase 1",
    "description": "Student routine, live class, smart classroom, and teacher material endpoints. Session APIs are intentionally excluded.",
